<Project>
  <!-- Import parent Directory.Build.props -->
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <PropertyGroup>
    <!-- Enable Jaribu multi-mode test registration -->
    <DefineConstants>$(DefineConstants);JARIBU_MULTI</DefineConstants>
    <!-- Suppress IDE0161 for multi-file compilation (block-scoped namespaces in test files) -->
    <NoWarn>$(NoWarn);IDE0161</NoWarn>
  </PropertyGroup>

  <!-- Same CI-safe set as ci-runner and mtp-runner. Wildcards would compile suites that are not in this list. -->
  <Import Project="$(MSBuildThisFileDirectory)ci-safe-tests.props" />
</Project>
