<Project Sdk="Microsoft.NET.Sdk">

  <!-- Import M.T.P. props for dotnet test / IDE integration -->
  <Import Project="../../../../source/timewarp-jaribu-testing-platform/build/timewarp.jaribu.testingplatform.props" />

  <PropertyGroup>
    <!-- Define JARIBU_MULTI so test files don't self-execute -->
    <DefineConstants>$(DefineConstants);JARIBU_MULTI</DefineConstants>
  </PropertyGroup>

  <!-- Compile items come from ../ci-safe-tests.props (imported by the parent Directory.Build.props).
       Sibling files are not in that list: file-based runners already compile them through
       #:include, and listing them there duplicates the Compile item. This project ignores #:include. -->
  <ItemGroup>
    <Compile Include="../../../../tools/dev-cli/endpoints/release-gate.cs" />
    <Compile Include="../../single-file-tests/core/test-runner.cancellation.fixtures.cs" />
    <Compile Include="../../single-file-tests/core/test-runner.silent-no-ops.filters.cs" />
    <Compile Include="../../single-file-tests/core/test-runner.timeout-policy.fixtures.cs" />
    <Compile Include="../../single-file-tests/core/test-runner.setup-once.fixtures.cs" />
    <Compile Include="../../single-file-tests/core/test-runner.setup-once.inheritance.cs" />
    <Compile Include="../../single-file-tests/core/test-runner.session-fixture.lifecycle.cs" />
    <Compile Include="../../single-file-tests/core/test-runner.session-fixture.failure.cs" />
    <Compile Include="../../single-file-tests/core/test-runner.session-fixture.fixtures.cs" />
    <Compile Include="../../single-file-tests/core/test-runner.session-fixture.concurrency.cs" />
    <Compile Include="../../single-file-tests/core/test-runner.runfile-coverage.launch.cs" />
    <Compile Include="../../single-file-tests/core/test-runner.runfile-coverage.manifest.cs" />
    <Compile Include="../../single-file-tests/core/test-runner.runfile-coverage.deterministic.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../../../source/timewarp-jaribu-testing-platform/timewarp-jaribu-testing-platform.csproj" />
    <PackageReference Include="Microsoft.Testing.Extensions.CodeCoverage" />
  </ItemGroup>

</Project>
