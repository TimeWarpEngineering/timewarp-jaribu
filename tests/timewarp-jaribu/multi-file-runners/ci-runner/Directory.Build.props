<Project>
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <PropertyGroup>
    <!-- The testing-platform ProjectReference flows Microsoft.Testing.Platform targets.
         Those default an empty IsTestingPlatformApplication to true and then emit a
         second Main. This runner already has a file-based entry point. -->
    <IsTestingPlatformApplication>false</IsTestingPlatformApplication>
    <GenerateTestingPlatformEntryPoint>false</GenerateTestingPlatformEntryPoint>
    <GenerateTestingPlatformConfigurationFile>false</GenerateTestingPlatformConfigurationFile>
    <GenerateSelfRegisteredExtensions>false</GenerateSelfRegisteredExtensions>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="$(MSBuildThisFileDirectory)..\..\..\..\source\timewarp-jaribu-testing-platform\timewarp-jaribu-testing-platform.csproj" />
    <PackageReference Include="TimeWarp.Amuru" />
  </ItemGroup>
</Project>
