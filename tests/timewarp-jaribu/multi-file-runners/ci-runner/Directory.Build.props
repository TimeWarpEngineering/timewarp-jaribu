<Project>
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <PropertyGroup>
    <!-- The testing-platform ProjectReference flows Microsoft.Testing.Platform targets.
         Those default an empty IsTestingPlatformApplication to true and then emit a
         second Main. This runner already has a file-based entry point. -->
    <IsTestingPlatformApplication>false</IsTestingPlatformApplication>
    <GenerateTestingPlatformEntryPoint>false</GenerateTestingPlatformEntryPoint>
    <GenerateTestingPlatformConfigurationFile>false</GenerateTestingPlatformConfigurationFile>
    <GenerateSelfRegisteredExtensions>false</GenerateSelfRegisteredExtensions>
  </PropertyGroup>

  <ItemGroup>
    <!-- Override: remove wildcard includes from parent, only include CI-safe tests -->
    <Compile Remove="../single-file-tests/**/*.cs" />

    <!-- CI-safe test files only (no intentional failures in registered meta-tests) -->
    <Compile Include="../../single-file-tests/core/test-runner.tag-filtering.cs" />
    <Compile Include="../../single-file-tests/core/test-runner.setup-once.cs" />
    <Compile Include="../../single-file-tests/core/test-runner.session-fixture.cs" />
    <Compile Include="../../single-file-tests/output/terminal-sink.tabular-output.cs" />
    <Compile Include="../../single-file-tests/api/test-runner.structured-results.cs" />
    <Compile Include="../../single-file-tests/api/test-runner.multi-class-registration.cs" />
    <Compile Include="../../single-file-tests/core/test-runner.input-identity.cs" />
    <Compile Include="../../single-file-tests/mtp/mtp-node-identity.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="$(MSBuildThisFileDirectory)..\..\..\..\source\timewarp-jaribu-testing-platform\timewarp-jaribu-testing-platform.csproj" />
    <PackageReference Include="TimeWarp.Amuru" />
  </ItemGroup>
</Project>
