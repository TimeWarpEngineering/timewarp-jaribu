<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>TimeWarp.Jaribu.TestingPlatform</PackageId>
    <Description>Microsoft.Testing.Platform adapter for TimeWarp.Jaribu test framework</Description>
    <!-- This is a library, not a test project -->
    <IsTestProject>false</IsTestProject>
    <IsTestingPlatformApplication>false</IsTestingPlatformApplication>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="Microsoft.Testing.Platform.Builder" />
    <Using Include="Microsoft.Testing.Platform.Capabilities.TestFramework" />
    <Using Include="Microsoft.Testing.Platform.Extensions" />
    <Using Include="Microsoft.Testing.Platform.Helpers" />
    <Using Include="Microsoft.Testing.Platform.Extensions.Messages" />
    <Using Include="Microsoft.Testing.Platform.Extensions.TestFramework" />
    <Using Include="Microsoft.Testing.Platform.Messages" />
    <Using Include="Microsoft.Testing.Platform.Requests" />
    <Using Include="Microsoft.Testing.Platform.TestHost" />
  </ItemGroup>

  <!--
    Local test assemblies. The grants are compiled into the assembly.
    The default stays on so a test build can reach internal types.
    The release pack passes JaribuExposeInternals=false, and the release gate
    rejects a packed lib assembly that still carries InternalsVisibleTo.
  -->
  <ItemGroup Condition="'$(JaribuExposeInternals)' != 'false'">
    <InternalsVisibleTo Include="run-ci-tests" />
    <!-- File-based runner tests/timewarp-jaribu/multi-file-runners/run-tests.cs. -->
    <InternalsVisibleTo Include="run-tests" />
    <InternalsVisibleTo Include="mtp-node-identity" />
    <InternalsVisibleTo Include="mtp-review-cleanups" />
    <!-- Multi-file MTP project; assembly name follows timewarp-jaribu-tests-mtp.csproj. -->
    <InternalsVisibleTo Include="timewarp-jaribu-tests-mtp" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Testing.Platform" />
    <PackageReference Include="Microsoft.Testing.Platform.MSBuild" />
    <ProjectReference Include="../timewarp-jaribu/timewarp-jaribu.csproj" />
  </ItemGroup>

  <!--
    Pack the test-project props to build/ only. NuGet imports build/ for a direct
    PackageReference and buildTransitive/ into that project and every project that
    references it. The buildTransitive targets force IsTestingPlatformApplication
    false unless EnableJaribuRunner is true or build/ set the direct-reference
    marker. Copying the build/ props into buildTransitive would mark a class
    library as a test executable.
  -->
  <ItemGroup>
    <None Include="build/**" Pack="true" PackagePath="build/" />
    <None Include="buildTransitive/**" Pack="true" PackagePath="buildTransitive/" />
  </ItemGroup>
</Project>
