<Project>
  <!--
    TimeWarp.Nuru.DevCli compiles its content files into this project.
    release-command.cs and nuget-version-service.cs are over the TWA0038 line
    limit. FileLengthAnalyzer skips paths that contain /obj/, so the copies
    compiled from the intermediate output are not our sources to split.
  -->
  <Target Name="CompileNuruDevCliContentFromObj" BeforeTargets="CoreCompile">
    <ItemGroup>
      <_NuruDevCliSource Include="@(Compile)"
        Condition="$([System.String]::Copy('%(Identity)').Contains('timewarp.nuru.devcli'))" />
    </ItemGroup>
    <MakeDir Directories="$(IntermediateOutputPath)nuru-devcli"
      Condition="'@(_NuruDevCliSource)' != ''" />
    <Copy SourceFiles="@(_NuruDevCliSource)"
      DestinationFiles="@(_NuruDevCliSource->'$(IntermediateOutputPath)nuru-devcli/%(Filename)%(Extension)')"
      SkipUnchangedFiles="true" />
    <ItemGroup>
      <Compile Remove="@(_NuruDevCliSource)" />
      <Compile Include="@(_NuruDevCliSource->'$(IntermediateOutputPath)nuru-devcli/%(Filename)%(Extension)')" />
    </ItemGroup>
  </Target>
</Project>
