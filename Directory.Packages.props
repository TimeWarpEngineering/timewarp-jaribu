<?xml version="1.0" encoding="utf-8"?>
<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <!-- TimeWarp packages -->
    <PackageVersion Include="TimeWarp.Amuru" Version="3.0.0-beta.2" />
    <!-- Newest publish. net11.0 asset; Amuru dependency is still the 2.0.0 minimum. -->
    <PackageVersion Include="TimeWarp.Nuru" Version="4.0.0-beta.12" />
    <PackageVersion Include="TimeWarp.Nuru.DevCli" Version="4.0.0-beta.12" />
    <PackageVersion Include="TimeWarp.Terminal" Version="1.0.2" />

    <!-- Test packages -->
    <PackageVersion Include="Shouldly" Version="4.3.0" />
    <PackageVersion Include="Microsoft.Testing.Platform" Version="2.5.3" />
    <PackageVersion Include="Microsoft.Testing.Platform.MSBuild" Version="2.5.3" />
    <!-- Moves with the platform. 18.12.0 requires Microsoft.Testing.Platform 2.5.0. -->
    <PackageVersion Include="Microsoft.Testing.Extensions.CodeCoverage" Version="18.12.0" />

    <!-- Analyzers -->
    <PackageVersion Include="Roslynator.Analyzers" Version="5.0.1" />
    <PackageVersion Include="Roslynator.CodeAnalysis.Analyzers" Version="5.0.1" />
    <PackageVersion Include="Roslynator.Formatting.Analyzers" Version="5.0.1" />
    <PackageVersion Include="Microsoft.CodeAnalysis.NetAnalyzers" Version="11.0.100" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp.CodeStyle" Version="5.9.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" Version="5.6.0" />
    <PackageVersion Include="TimeWarp.Build.Tasks" Version="2.0.0" />
    <PackageVersion Include="TimeWarp.Amuru.Tools" Version="3.0.0-beta.2" />
    <PackageVersion Include="TimeWarp.SourceGenerators" Version="1.0.0-beta.14" />

    <!-- Benchmark hosts (task 040). Results headers copy these versions. -->
    <PackageVersion Include="BenchmarkDotNet" Version="0.15.8" />
    <PackageVersion Include="Fixie" Version="4.2.0" />
    <PackageVersion Include="Fixie.TestAdapter" Version="4.2.0" />
    <PackageVersion Include="TimeWarp.Fixie" Version="3.1.0" />
    <PackageVersion Include="TUnit" Version="1.83.0" />
    <PackageVersion Include="xunit.v3.mtp-v2" Version="4.0.3" />
  </ItemGroup>
</Project>
