<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>fixie-bench</AssemblyName>
    <!-- Fixie.Main.cs is removed in Directory.Build.targets. Generated workload
         files still await without ConfigureAwait. -->
    <NoWarn>$(NoWarn);CA2007</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Fixie" />
    <PackageReference Include="Fixie.TestAdapter" />
    <PackageReference Include="TimeWarp.Fixie" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="../generated/fixie/$(BenchWorkload)/*.g.cs" />
  </ItemGroup>
</Project>
